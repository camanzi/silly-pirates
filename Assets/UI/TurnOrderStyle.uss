:root {
    --color-card-active: rgb(70, 110, 170);
    --color-card-waiting: rgb(50, 55, 65);
    --color-card-border-active: rgb(255, 200, 100);
    --color-card-border-waiting: rgba(255, 255, 255, 0.2);
    --card-width: 200px;
    --card-height-active: 150px;
    --card-height-waiting: 125px;
    --icon-size-active: 80px;
    --icon-size-waiting: 50px;
    --transition-speed: 0.3s;
    --unity-metrics-single_line-height: 20px;
}

.turn-order-container {
    background-color: rgba(20, 20, 30, 0.8);
    border-radius: 10px;
    width: 100%;
    height: 100%;
}

.turn-list {
    width: 100%;
    background-color: transparent;
    border-width: 0;
}


.turn-list > .unity-scroll-view {
    background-color: transparent;
}

.turn-list .unity-list-view__item {
    margin: 0;
    padding: 0;
    background-color: transparent;
}

.turn-card {
    width: var(--card-width);
    height: var(--card-height-waiting);
    background-color: var(--color-card-waiting);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--color-card-border-waiting);
    margin-bottom: 10px;
    padding: 8px;
    flex-direction: row;
    align-items: center;
    overflow: visible;
    transition-property: height, background-color, border-color, border-width, scale;
    transition-duration: var(--transition-speed);
    transition-timing-function: ease-in-out;
}

.turn-card--active {
    height: var(--card-height-active);
    background-color: var(--color-card-active);
    border-color: var(--color-card-border-active);
    border-width: 3px;
    animation-name: pulse-glow;
    animation-duration: 2s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
}

.turn-card--waiting {
    height: var(--card-height-waiting);
    opacity: 0.9;
}

.turn-card__icon-container {
    width: var(--icon-size-waiting);
    height: var(--icon-size-waiting);
    flex-shrink: 0;
    margin-right: 10px;
    justify-content: center;
    align-items: center;
    transition-property: width, height, translate;
    transition-duration: var(--transition-speed);
    transition-timing-function: ease-out;
}

.turn-card__icon {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(40, 40, 50);
    transition-property: border-color, border-width;
    transition-duration: var(--transition-speed);
}

.turn-card--active .turn-card__icon-container {
    width: var(--icon-size-active);
    height: var(--icon-size-active);
    translate: -18px 0;
}

.turn-card--active .turn-card__icon {
    border-width: 3px;
    border-color: var(--color-card-border-active);
    animation-name: icon-pulse;
    animation-duration: 2s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
}

.turn-card__info {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    overflow: hidden;
    padding-left: 5px;
}

.turn-card__name {
    font-size: 13px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition-property: font-size, color;
    transition-duration: var(--transition-speed);
}

.turn-card--active .turn-card__name {
    font-size: 15px;
    color: rgb(255, 255, 255);
}

.turn-card__hp {
    font-size: 11px;
    color: rgb(180, 180, 180);
    transition-property: font-size, color;
    transition-duration: var(--transition-speed);
}

.turn-card--active .turn-card__hp {
    font-size: 13px;
    -unity-font-style: bold;
}

.turn-card--damaged {
    animation-name: damage-shake;
    animation-duration: 0.5s;
    animation-timing-function: ease-in-out;
}

.turn-card--healed {
    animation-name: heal-glow;
    animation-duration: 0.6s;
    animation-timing-function: ease-out;
}