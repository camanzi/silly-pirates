/* Main menu. Lives in the MainMenu scene, not the persistent one: every scene owns its own UI, so
   there is no leftover screen state to reset between loads.

   The font and the shared stage/quill primitives come from STL_Menu.uss, included before this
   sheet. Coordinates are those of the Figma "Main Menu" canvas (1920x1080). */

/* --- Moving Group ------------------------------------------------------------------------ */

.drake-layer {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.drake-9 { left: 0; top: 0; width: 1920px; height: 1080px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_9.png"); }

.drake-6 { left: 413px; top: 729px; width: 688px; height: 351px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_6.png"); }

.drake-5 { left: 1771px; top: 233px; width: 148.5px; height: 336.32px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_5.png"); }

.drake-2 { left: 1225px; top: 602px; width: 694.5px; height: 478.5px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_2.png"); }

.drake-3 { left: 949px; top: 816px; width: 535.5px; height: 264px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_3.png"); }

.drake-4 { left: 835px; top: 2px; width: 973.5px; height: 756px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_4.png"); }

.drake-7 { left: 0; top: 41px; width: 194.75px; height: 250.75px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_7.png"); }

.drake-8 { left: 67px; top: 2px; width: 256px; height: 122px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_8.png"); }

/* --- Menu buttons ------------------------------------------------------------------------- */

/* UI Toolkit's default runtime theme styles every Button (margin, border, background, and its own
   :hover/:focus/:active/:disabled variants). All of it must be zeroed here, including the
   pseudo-class variants specifically: a bare .menu-button reset does not outrank
   .unity-button:hover, which has the same class+pseudo-class specificity. Skipping this shows a
   grey rounded rectangle on hover/focus that is not in the mockup. */
.menu-button, .menu-button:hover, .menu-button:focus, .menu-button:active, .menu-button:disabled {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

/* 453x53 with a 96px font: the text overflows the box, exactly like in Figma. The box stays the
   clickable/hoverable surface, so it must not be widened to "fit" the glyphs. */
.menu-button {
    position: absolute;
    font-size: 96px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Attenuated just enough to read as unavailable. Toggled by MenuButton.Selectable itself
   (EnableInClassList), never authored directly in UXML: a hand-authored class here and the
   selectable flag would be two sources of truth that could drift apart. */
.menu-button--disabled {
    opacity: 0.45;
}

/* Anchored to the left edge of the TEXT, not of the button's box: MenuButton computes left/top
   itself, in its own local content rect, from the measured text width — not expressible in USS.
   Width starts at zero: no entry is born underlined, the initial selection takes care of that. */
.menu-button__underline {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 3px;
    background-color: rgb(0, 0, 0);
}

#menu-play, #menu-options, #menu-quit { left: 186px; width: 453px; height: 53px; }
#menu-play { top: 442px; }
#menu-options { top: 576px; }
#menu-quit { top: 710px; }

/* --- Selection marker --------------------------------------------------------------------- */

.selection-marker {
    position: absolute;
}

.selection-marker__quill {
    position: absolute;
    width: 128px;
    height: 128px;
}

/* Same box as a menu row: sliding in Y alone lines the quill up with the selected row. */
#menu-marker { left: 186px; top: 442px; width: 453px; height: 53px; }
#menu-marker .selection-marker__quill { left: 10px; top: -36px; }

/* --- Menu items row ------------------------------------------------------------------------ */

.menu-items {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
}

/* --- Title screen -------------------------------------------------------------------------- */

/* 1920x555 box with a 200px font: the text is centred within the box, not pinned to its edge, and
   sits much lower than it. These are the mockup's own measurements, not meant to hug the text. */
.title-text {
    position: absolute;
    left: 0;
    top: 227px;
    width: 1920px;
    height: 555px;
    font-size: 200px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Sized like a single menu row: PulsingGroup only needs enough room for its own quill + button. */
.title-prompt-group {
    position: absolute;
    left: 733px;
    top: 801px;
    width: 453px;
    height: 53px;
}

/* Both children simply fill the group; each still positions its own internals (the quill's offset,
   the underline) relative to that shared 453x53 frame. */
#title-marker { left: 0; top: 0; width: 100%; height: 100%; }
/* Here the quill sits OUTSIDE the box (negative left), unlike the menu: "Press any button" nearly
   fills the 453px box and leaves no margin for the quill to sit inside. */
#title-marker .selection-marker__quill { left: -128px; top: -38px; }

#title-prompt-label { left: 0; top: 0; width: 100%; height: 100%; }
