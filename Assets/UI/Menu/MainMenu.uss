/* Main menu. Vive nella scena MainMenu, non in quella persistente: ogni scena possiede
   la propria UI, cosi' non resta stato di schermata da resettare tra un caricamento e l'altro.

   Il font NON si dichiara qui: arriva da STL_Menu.uss, incluso prima di questo foglio.
   Le coordinate sono quelle del canvas Figma "Main Menu" (1920x1080) e vanno lette insieme
   allo stage, che e' l'unico elemento a misura fissa. */

.menu-root {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Tinta media della pergamena: si vede solo per il frame in cui lo stage non ha ancora
       misurato, e nelle bande che il cover ritaglia. Meglio di un nero che lampeggia. */
    background-color: rgb(236, 224, 206);
    overflow: hidden;
}

/* Misura fissa e centrata. A farlo coprire lo schermo ci pensa MainMenuPanelSettings
   (ScaleWithScreenSize + Shrink su 1920x1080): niente scaling a mano, cosi' il testo resta
   nitido perche' passa dal scaledPixelsPerPoint del pannello e non da un transform. */
.menu-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 1920px;
    height: 1080px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/parchment.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* --- Moving Group ------------------------------------------------------------------------ */

.drake-layer {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.drake-9 { left: 0; top: 0; width: 1920px; height: 1080px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_9.png"); }

.drake-6 { left: 413px; top: 729px; width: 688px; height: 351px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_6.png"); }

.drake-5 { left: 1771px; top: 233px; width: 148.5px; height: 336.32px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_5.png"); }

.drake-2 { left: 1225px; top: 602px; width: 694.5px; height: 478.5px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_2.png"); }

.drake-3 { left: 949px; top: 816px; width: 535.5px; height: 264px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_3.png"); }

.drake-4 { left: 835px; top: 2px; width: 973.5px; height: 756px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_4.png"); }

.drake-7 { left: 0; top: 41px; width: 194.75px; height: 250.75px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_7.png"); }

.drake-8 { left: 67px; top: 2px; width: 256px; height: 122px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_8.png"); }

/* --- Voci di menu ------------------------------------------------------------------------- */

.menu-items {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
}

/* 453x53 con font 96px: il testo deborda dal box, esattamente come in Figma. Il box resta la
   superficie cliccabile/hoverabile, quindi non va allargato per "contenere" i glifi. */
.menu-item {
    position: absolute;
    left: 186px;
    width: 453px;
    height: 53px;
    font-size: 96px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

#menu-play { top: 442px; }
#menu-options { top: 576px; }
#menu-quit { top: 710px; }

/* Options e' disegnata come da mockup ma inerte: attenuata quel tanto che basta a leggersi come
   non disponibile, e saltata dalla navigazione (vedi MainMenuSelection). */
.menu-item--disabled {
    opacity: 0.45;
}

/* --- Marker di selezione ------------------------------------------------------------------ */

/* Stessa cassa di una voce: scorrendo in Y la piuma si allinea da sola alla riga selezionata.
   La sottolineatura NON sta qui dentro: non deve viaggiare con la piuma. */
.menu-marker {
    position: absolute;
    left: 186px;
    top: 442px;
    width: 453px;
    height: 53px;
}

.menu-marker__quill {
    position: absolute;
    left: 10px;
    top: -36px;
    width: 128px;
    height: 128px;
    /* In Figma il nodo e' ruotato di 180 gradi e specchiato in verticale: la risultante e' un
       semplice specchio orizzontale. */
    scale: -1 1;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/quill.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Una per voce. Ancorata al bordo SINISTRO del testo: e' da li' che la linea si scrive verso
   destra quando la voce viene scelta, e verso li' che si ritira quando viene abbandonata.
   'left' e 'top' li calcola MainMenuSelection dal rettangolo della Label, perche' dipendono dalla
   larghezza del testo, che in USS non e' esprimibile. La larghezza parte a zero: nessuna voce
   nasce sottolineata, ci pensa la selezione iniziale. */
.menu-underline {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 3px;
    background-color: rgb(0, 0, 0);
}

/* --- Title screen -------------------------------------------------------------------------- */

/* Gemella di .menu-stage: stessa misura fissa, stesso centraggio, stessa pergamena. Deve essere
   OPACA, perche' sotto di lei il menu e' gia' montato (voci nascoste, drago a opacita' zero) e il
   suo fade-out e' l'unica cosa che separa le due pagine. */
.title-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 1920px;
    height: 1080px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/parchment.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* Cassa 1920x555 con font 200px: il testo e' centrato nella cassa, non incollato al suo bordo, ed
   e' molto piu' basso di lei. Sono le misure del mockup, non vanno strette al testo. */
.title-text {
    position: absolute;
    left: 0;
    top: 227px;
    width: 1920px;
    height: 555px;
    font-size: 200px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Come .menu-items: una cassa a tutto stage, cosi' la sottolineatura (che MainMenuSelection
   posiziona in coordinate assolute dal layout della Label) vive nello stesso spazio del testo. */
.title-prompt {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
}

/* Stessa cassa del prompt, cosi' MainMenuSelection puo' allineare la piuma scrivendo 'top' con la
   y della Label, esattamente come fa nel menu. */
.title-marker {
    position: absolute;
    left: 733px;
    top: 801px;
    width: 453px;
    height: 53px;
}

/* Qui la piuma sta FUORI dalla cassa (left negativo), non dentro come nel menu: "Press any button"
   riempie quasi tutti i 453px e non lascia il margine in cui la piuma sta nel menu.
   Lo specchio orizzontale e' lo stesso: in Figma il nodo e' ruotato di 180 gradi e specchiato in
   verticale, e la risultante e' un semplice 'scale: -1 1'. */
.title-marker__quill {
    position: absolute;
    left: -128px;
    top: -38px;
    width: 128px;
    height: 128px;
    scale: -1 1;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/quill.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Gemella di .menu-item: stessa cassa 453x53 e stesso font 96px, perche' deve leggersi come una
   voce di menu selezionata. Resta pickabile (niente picking-mode Ignore nel UXML): il click vale
   come "premi un tasto qualsiasi". */
.title-prompt__label {
    position: absolute;
    left: 733px;
    top: 801px;
    width: 453px;
    height: 53px;
    font-size: 96px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
