/* Main menu. Lives in the MainMenu scene, not the persistent one: every scene owns its own UI, so
   there is no leftover screen state to reset between loads.

   The font and the shared stage/quill primitives come from STL_Menu.uss, included before this
   sheet. Coordinates are those of the Figma "Main Menu" canvas (1920x1080). */

/* --- Moving Group ------------------------------------------------------------------------ */

.drake-layer {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.drake-9 { left: 0; top: 0; width: 1920px; height: 1080px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_9.png"); }

.drake-6 { left: 413px; top: 729px; width: 688px; height: 351px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_6.png"); }

.drake-5 { left: 1771px; top: 233px; width: 148.5px; height: 336.32px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_5.png"); }

.drake-2 { left: 1225px; top: 602px; width: 694.5px; height: 478.5px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_2.png"); }

.drake-3 { left: 949px; top: 816px; width: 535.5px; height: 264px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_3.png"); }

.drake-4 { left: 835px; top: 2px; width: 973.5px; height: 756px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_4.png"); }

.drake-7 { left: 0; top: 41px; width: 194.75px; height: 250.75px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_7.png"); }

.drake-8 { left: 67px; top: 2px; width: 256px; height: 122px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/drake_8.png"); }

/* --- Menu buttons ------------------------------------------------------------------------- */

/* The theme reset, colour, alignment, underline and disabled look of '.menu-button' are shared and
   live in STL_Menu.uss. Only this screen's layout is here.

   453x53 with a 96px font: the text overflows the box, exactly like in Figma. The box stays the
   clickable/hoverable surface, so it must not be widened to "fit" the glyphs. */
.menu-button {
    position: absolute;
    font-size: 96px;
}

#menu-play, #menu-options, #menu-quit { left: 186px; width: 453px; height: 53px; }
#menu-play { top: 442px; }
#menu-options { top: 576px; }
#menu-quit { top: 710px; }

/* --- Selection marker --------------------------------------------------------------------- */

/* Row height, so the quill can be centred on the row. 'left' and 'top' here are only the
   pre-layout starting point: SelectionMarker.MoveTo overwrites both, parking the marker on the
   selected entry's TEXT left edge (not its 453px box) and on its row. */
#menu-marker { left: 186px; top: 442px; height: 53px; }
/* -150px = the 128px quill plus a gap. The quill PNG has ~18px of transparent margin on each side
   at this size, so the visible gap to the text is ~40px, matching the mockups. top -36px centres
   the 128px quill on the 53px row ((53 - 128) / 2, rounded to the old calibrated value). */
#menu-marker .selection-marker__quill { left: -150px; top: -36px; }

/* --- Menu items row ------------------------------------------------------------------------ */

.menu-items {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
}

/* --- Title screen -------------------------------------------------------------------------- */

/* 1920x555 box with a 200px font: the text is centred within the box, not pinned to its edge, and
   sits much lower than it. These are the mockup's own measurements, not meant to hug the text. */
.title-text {
    position: absolute;
    left: 0;
    top: 227px;
    width: 1920px;
    height: 555px;
    font-size: 200px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Sized like a single menu row: PulsingGroup only needs enough room for its own quill + button. */
.title-prompt-group {
    position: absolute;
    left: 733px;
    top: 801px;
    width: 453px;
    height: 53px;
}

/* Both children share the group's 453x53 frame. The marker is the usual zero-width anchor that
   MoveTo parks on the text's left edge (here just inside the box: "Press any button" nearly fills
   it); it only needs the row height to centre the quill. */
#title-marker { left: 0; top: 0; height: 100%; }
/* Same quill-to-text gap as the menu entries, so the two screens read as one family. */
#title-marker .selection-marker__quill { left: -150px; top: -38px; }

#title-prompt-label { left: 0; top: 0; width: 100%; height: 100%; }
