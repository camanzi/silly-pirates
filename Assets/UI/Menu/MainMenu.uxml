<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- STL_Menu first: it carries the font plus the shared stage/quill primitives, and later
         sheets must not be able to override it by accident. MainMenu.uss handles sizes, colours
         and positions specific to this screen. -->
    <Style src="project://database/Assets/UI/Shared/STL_Menu.uss"/>
    <Style src="project://database/Assets/UI/Menu/MainMenu.uss"/>
    <ui:VisualElement name="menu-root" class="screen-root menu-root">
        <!-- The stage is a fixed 1920x1080 box, centred: inside it every child uses the exact
             coordinates from the Figma mockup. Covering the actual screen is the job of the menu's
             PanelSettings (ScaleWithScreenSize + Shrink), not of any scaling code. -->
        <ui:VisualElement name="menu-stage" class="parchment-stage">
            <!-- Moving Group: document order IS the mockup's z-order, from back to front. -->
            <ui:VisualElement name="drake-9" picking-mode="Ignore" class="drake-layer drake-9"/>
            <ui:VisualElement name="drake-6" picking-mode="Ignore" class="drake-layer drake-6"/>
            <ui:VisualElement name="drake-5" picking-mode="Ignore" class="drake-layer drake-5"/>
            <ui:VisualElement name="drake-2" picking-mode="Ignore" class="drake-layer drake-2"/>
            <ui:VisualElement name="drake-3" picking-mode="Ignore" class="drake-layer drake-3"/>
            <ui:VisualElement name="drake-4" picking-mode="Ignore" class="drake-layer drake-4"/>
            <ui:VisualElement name="drake-7" picking-mode="Ignore" class="drake-layer drake-7"/>
            <ui:VisualElement name="drake-8" picking-mode="Ignore" class="drake-layer drake-8"/>

            <!-- The single shared quill; a sibling of the entries so it can slide between rows with
                 one tween instead of appearing/disappearing inside each one. -->
            <SelectionMarker name="menu-marker" picking-mode="Ignore" slide-duration="0.25" slide-ease="OutCubic"/>

            <ui:VisualElement name="menu-items" picking-mode="Ignore" class="menu-items">
                <MenuButton name="menu-play" text="Play" focusable="false"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
                <!-- Drawn as in the mockup but inert: MainMenuController marks it non-selectable so
                     arrow keys skip over it instead of stopping on an entry that does nothing. -->
                <MenuButton name="menu-options" text="Options" focusable="false" selectable="false"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
                <MenuButton name="menu-quit" text="Quit" focusable="false"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Title screen: a proxy page in front of the menu, not a scene of its own. Sits AFTER
             menu-stage in the document, so above it in z-order, and carries its own parchment: it
             is opaque, so its own opacity fade-out already IS the cross-fade into the menu waiting
             beneath it. Once dismissed, TitleScreenPage sets it to display:none and never turns it
             back on. -->
        <ui:VisualElement name="title-stage" class="parchment-stage">
            <!-- Read once by SweepRevealLabel and never again from the outside: from that point on
                 its 'text' carries reveal markup and is no longer a source of truth. -->
            <SweepRevealLabel name="title-text" picking-mode="Ignore" text="A Pirates Story" class="title-text"
                sweep-duration="2" sweep-falloff="300" sweep-ease="InOutSine"/>

            <!-- Sized like a single menu row (453x53), not the whole stage: the only reason it used
                 to be 1920x1080 was so the underline and the label could share one coordinate
                 space, and that reason is gone now that the underline lives inside MenuButton. Its
                 one remaining job is fading in and pulsing the quill and the label together. -->
            <PulsingGroup name="title-prompt-group" class="title-prompt-group"
                fade-in-duration="0.5" pulse-min-opacity="0.5" pulse-duration="1.25">
                <SelectionMarker name="title-marker" picking-mode="Ignore" slide-duration="0.25" slide-ease="OutCubic"/>
                <MenuButton name="title-prompt-label" text="Press any button" focusable="false"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
            </PulsingGroup>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
