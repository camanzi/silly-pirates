/* Loading overlay. Lives in the persistent scene on a dedicated PanelSettings with a high sorting
   order: it must cover the combat HUD (which sits at 10) and the end-of-combat panel (50) while the
   scene underneath is unloaded and reloaded.

   The font and the shared stage/quill primitives come from STL_Menu.uss, included before this
   sheet — the same one the main menu uses. */

.loading-root {
    /* .screen-root already covers position/size/background; this sheet only adds the fade-driven
       starting state. Visibility is driven by LoadingScreenController via PrimeTween, not by
       display, so the fade can be interpolated. */
    opacity: 0;
    display: none;
}

/* Anchored bottom-right, as in the mockup. Left-aligned within a box wider than the text: that is
   how the three dots can appear without the word "Loading" itself shifting. */
.loading-label {
    position: absolute;
    left: 1587px;
    top: 979px;
    width: 297px;
    height: 101px;
    font-size: 70px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* Same quill as the main menu, same horizontal flip. Vertical position is animated from code via
   'translate', so 'top' stays fixed here. */
.loading-quill {
    position: absolute;
    left: 1772px;
    top: 968px;
    width: 112px;
    height: 112px;
}
