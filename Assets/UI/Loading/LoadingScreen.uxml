<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- STL_Menu per primo, come fa MainMenu.uxml: porta solo il font, e il foglio della schermata
         non deve poterlo sovrascrivere per sbaglio. -->
    <Style src="project://database/Assets/UI/Shared/STL_Menu.uss"/>
    <Style src="project://database/Assets/UI/Loading/LoadingScreen.uss"/>
    <ui:VisualElement name="loading-root" picking-mode="Ignore" class="loading-root">
        <!-- Stesso schema del main menu: uno stage fisso 1920x1080 centrato, dentro cui i figli
             usano le coordinate esatte del mockup. A coprire lo schermo ci pensa PS_LoadingScreen
             (ScaleWithScreenSize + Shrink), non del codice di scaling. -->
        <ui:VisualElement name="loading-stage" picking-mode="Ignore" class="loading-stage">
            <!-- Parte senza puntini: li aggiunge LoadingScreenController scambiando fra quattro
                 stringhe gia' pronte. La cassa e' misurata in Figma su "Loading..." e il testo e'
                 allineato a sinistra, quindi i puntini crescono verso destra senza spostare nulla. -->
            <ui:Label name="loading-label" picking-mode="Ignore" text="Loading" class="loading-label"/>
            <ui:VisualElement name="loading-quill" picking-mode="Ignore" class="loading-quill"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
