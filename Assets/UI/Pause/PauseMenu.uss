/* The in-combat pause menu. Lives in the combat scene, on a PanelSettings at sortingOrder 75:
   above the HUD (10) and above the end-of-combat panel (50), so it can never be drawn underneath
   either, and below the loading overlay (100), which has to be able to cover it once a restart or
   a return-to-menu transition starts.

   Unlike the end-of-combat screen this one does NOT cover the game with parchment: the frozen
   scene stays visible behind a light veil, and only a torn sheet sits in the middle. The veil is
   there to separate the sheet from a busy background, not to hide the game.

   The font, the MenuButton reset/underline and the quill come from STL_Menu.uss, included before
   this sheet. Coordinates are those of the Figma "Pause menu" canvas (1920x1080); font sizes were
   measured on its export (cap heights), not copied from the main menu.

   Rules that are load-bearing:
   - hide with 'display: none', NEVER with 'opacity: 0' alone. A transparent but still drawn element
     stays pickable and would eat clicks on the world for the whole combat.
   - nothing here animates on scaled time: the pause sets Time.timeScale to 0. The fades and the
     quill/underline tweens all run with useUnscaledTime in C#, and there are no USS transitions
     left that would need it. */

.pause-root {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    overflow: hidden;
    /* See the header: display, not opacity, or the panel keeps swallowing clicks while "hidden". */
    display: none;
    opacity: 0;
}

/* Same centring technique as .parchment-stage in STL_Menu.uss, minus the background: the game is
   meant to show through everywhere except the sheet. */
.pause-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 1920px;
    height: 1080px;
    flex-shrink: 0;
}

/* The torn sheet: a full-height 1286x1080 export whose visible paper spans roughly x 511-1412 of
   the stage. The PNG is NPOT and imported with nPOTScale 0, otherwise Unity would rescale it to a
   power of two and the paper would shift inside this box. */
.pause-frame {
    position: absolute;
    left: 285px;
    top: 0;
    width: 1286px;
    height: 1080px;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/Pause/pause_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* A page covers just the visible paper, so every coordinate below is sheet-relative and the
   entries centre on the sheet rather than on the screen (the two differ by ~1px here, but the
   sheet is what the eye reads). The two pages overlap exactly: the confirmation REPLACES the
   entries on the same sheet. */
.pause-page {
    position: absolute;
    left: 511px;
    top: 0;
    width: 901px;
    height: 1080px;
}

/* Hidden by default; PauseMenuController toggles display, same rule as the root. */
.pause-confirm {
    display: none;
}

/* Centred on y ~300, as in the mockup. */
.pause-title {
    position: absolute;
    left: 0;
    top: 240px;
    width: 100%;
    height: 120px;
    margin: 0;
    padding: 0;
    font-size: 96px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Fits on two lines inside the paper; replaces the title's slot while the question is asked. */
.pause-confirm-text {
    position: absolute;
    left: 110px;
    top: 250px;
    width: 681px;
    height: 220px;
    margin: 0;
    padding: 0;
    font-size: 64px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* The box is the hover/click surface and is wider than the longest entry ("Return to main menu"
   measures ~415px at this size); the text is centred in it, and the underline and quill anchor to
   the text, not to this box. */
.pause-entry {
    position: absolute;
    left: 150px;
    width: 600px;
    height: 60px;
    font-size: 72px;
}

/* Row centres from the mockup: ~505, ~620, ~737. The confirmation's two answers reuse rows 2 and 3. */
.pause-entry--1 { top: 475px; }
.pause-entry--2 { top: 590px; }
.pause-entry--3 { top: 707px; }

/* left/top are only the pre-layout start: SelectionMarker.MoveTo overwrites both. The height is
   the row's, so the quill below can be centred on it. */
.pause-marker {
    left: 150px;
    top: 475px;
    height: 60px;
}

/* Smaller than the main menu's 128px quill, as in the mockup (the entries are smaller too).
   left: the 112px quill has ~16px of transparent margin on its right at this size, so -136px
   leaves a visible gap of ~40px to the text. top: (60 - 112) / 2 centres it on the row. */
.pause-marker .selection-marker__quill {
    left: -136px;
    top: -26px;
    width: 112px;
    height: 112px;
}
