<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- STL_Menu first: font, MenuButton reset/underline and the quill primitives are shared with
         the main menu. PauseMenu.uss only carries this screen's veil, sheet and coordinates. -->
    <Style src="project://database/Assets/UI/Shared/STL_Menu.uss"/>
    <Style src="project://database/Assets/UI/Pause/PauseMenu.uss"/>
    <!-- Full-screen and pickable: this is what blocks clicks on the world while paused. Hidden with
         display:none (see PauseMenu.uss) the rest of the time. Focus target for arrow keys/gamepad. -->
    <ui:VisualElement name="pause-root" class="pause-root">
        <!-- Fixed 1920x1080 box, centred: every child uses the Figma "Pause menu" coordinates.
             Scaling to the real screen is PS_PauseMenu's job (ScaleWithScreenSize + Shrink). -->
        <ui:VisualElement name="pause-stage" picking-mode="Ignore" class="pause-stage">
            <ui:VisualElement name="pause-frame" picking-mode="Ignore" class="pause-frame"/>

            <!-- Main page. The marker is a sibling of the entries so it shares their coordinate
                 space: SelectionMarker.MoveTo reads the entry's layout relative to this page. -->
            <ui:VisualElement name="pause-main" picking-mode="Ignore" class="pause-page">
                <ui:Label name="pause-title" picking-mode="Ignore" text="Paused" class="pause-title"/>
                <SelectionMarker name="pause-marker" picking-mode="Ignore" class="pause-marker" slide-duration="0.25" slide-ease="OutCubic"/>
                <MenuButton name="pause-resume" text="Resume" focusable="false" class="pause-entry pause-entry--1"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
                <MenuButton name="pause-restart" text="Restart" focusable="false" class="pause-entry pause-entry--2"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
                <MenuButton name="pause-menu" text="Return to main menu" focusable="false" class="pause-entry pause-entry--3"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
            </ui:VisualElement>

            <!-- Restart confirmation: on the SAME sheet, it replaces the main page instead of
                 opening a second popup. PauseMenuController swaps the two with display. -->
            <ui:VisualElement name="pause-confirm" picking-mode="Ignore" class="pause-page pause-confirm">
                <ui:Label name="pause-confirm-text" picking-mode="Ignore" text="Restart the battle? All progress in this fight will be lost." class="pause-confirm-text"/>
                <SelectionMarker name="pause-confirm-marker" picking-mode="Ignore" class="pause-marker" slide-duration="0.25" slide-ease="OutCubic"/>
                <MenuButton name="pause-confirm-yes" text="Restart" focusable="false" class="pause-entry pause-entry--2"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
                <MenuButton name="pause-confirm-no" text="Cancel" focusable="false" class="pause-entry pause-entry--3"
                    underline-in-duration="0.24" underline-in-ease="OutQuad" underline-in-delay="0.1"
                    underline-out-duration="0.16" underline-out-ease="InQuad"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
