/* Shared primitives for every menu-family screen (main menu, title screen, loading screen, and
   future ones such as Options): the font, the 1920x1080 parchment stage box, and the base quill
   look. Per-screen sheets keep only what actually differs between screens — exact positions,
   sizes, and screen-specific state such as loading-root's own opacity/display. */

:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Italianno-Regular.ttf");
}

/* Full-bleed root shared by every screen: same average parchment tint (visible only for the frame
   before the stage below has measured, and in the bands the cover crops away), same overflow rule. */
.screen-root {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(236, 224, 206);
    overflow: hidden;
}

/* Fixed size, centred. Covering the actual screen is the job of each screen's own PanelSettings
   (ScaleWithScreenSize + Shrink on 1920x1080): no scaling in code, so text stays crisp because it
   goes through the panel's scaledPixelsPerPoint instead of a transform. */
.parchment-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 1920px;
    height: 1080px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/parchment.png");
    -unity-background-scale-mode: scale-and-crop;
}

.quill-icon {
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/quill.png");
    -unity-background-scale-mode: scale-to-fit;
    /* In Figma the node is rotated 180 degrees and mirrored vertically; the result is a plain
       horizontal flip. */
    scale: -1 1;
}
