/* Shared primitives for every menu-family screen (main menu, title screen, loading screen, and
   future ones such as Options): the font, the 1920x1080 parchment stage box, and the base quill
   look. Per-screen sheets keep only what actually differs between screens — exact positions,
   sizes, and screen-specific state such as loading-root's own opacity/display. */

:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Italianno-Regular.ttf");
}

/* Full-bleed root shared by every screen: same average parchment tint (visible only for the frame
   before the stage below has measured, and in the bands the cover crops away), same overflow rule. */
.screen-root {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(236, 224, 206);
    overflow: hidden;
}

/* Fixed size, centred. Covering the actual screen is the job of each screen's own PanelSettings
   (ScaleWithScreenSize + Shrink on 1920x1080): no scaling in code, so text stays crisp because it
   goes through the panel's scaledPixelsPerPoint instead of a transform. */
.parchment-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 1920px;
    height: 1080px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/parchment.png");
    -unity-background-scale-mode: scale-and-crop;
}

.quill-icon {
    background-image: url("project://database/Assets/Imports/2D/UI Icons/MainMenu/quill.png");
    -unity-background-scale-mode: scale-to-fit;
    /* In Figma the node is rotated 180 degrees and mirrored vertically; the result is a plain
       horizontal flip. */
    scale: -1 1;
}

/* --- Menu buttons (MenuButton) -------------------------------------------------------------- */

/* UI Toolkit's default runtime theme styles every Button (margin, border, background, and its own
   :hover/:focus/:active/:disabled variants). All of it must be zeroed here, including the
   pseudo-class variants specifically: a bare .menu-button reset does not outrank
   .unity-button:hover, which has the same class+pseudo-class specificity. Skipping this shows a
   grey rounded rectangle on hover/focus that is not in the mockup.

   Only the look lives here. Position, box size and font-size are per-screen (the main menu pins
   each entry absolutely at 96px, the pause menu stacks them in a flex column at a smaller size):
   putting 'position: absolute' or a font-size in this shared sheet would force one screen's layout
   onto every other. */
.menu-button, .menu-button:hover, .menu-button:focus, .menu-button:active, .menu-button:disabled {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.menu-button {
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Attenuated just enough to read as unavailable. Toggled by MenuButton.Selectable itself
   (EnableInClassList), never authored directly in UXML: a hand-authored class here and the
   selectable flag would be two sources of truth that could drift apart.
   Not the same thing as the :disabled pseudo-state (SetEnabled(false), which the pause and
   end-of-combat screens use to block a double request while the scene transition starts). */
.menu-button--disabled {
    opacity: 0.45;
}

/* Anchored to the left edge of the TEXT, not of the button's box: MenuButton computes left/top
   itself, in its own local content rect, from the measured text width — not expressible in USS.
   Width starts at zero: no entry is born underlined, the initial selection takes care of that. */
.menu-button__underline {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 3px;
    background-color: rgb(0, 0, 0);
}

/* --- Selection marker (SelectionMarker) ----------------------------------------------------- */

/* The marker box itself is a zero-width anchor: SelectionMarker.MoveTo parks its left edge on the
   selected entry's TEXT left edge and its top on the entry's row. Each screen gives it the row
   height (so the quill can be centred on it) and pushes the quill out to the left with a negative
   'left' on .selection-marker__quill — that negative offset IS the quill-to-text gap. */
.selection-marker {
    position: absolute;
    width: 0;
}

.selection-marker__quill {
    position: absolute;
    width: 128px;
    height: 128px;
}
