.damage-popup {
    position: absolute;
    translate: -50% -50%;
}

.number-group {
    align-items: center;
    overflow: visible;
    font-size: 80px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.damage-label {
    padding: 0;
    margin: 0;
    color: rgb(255, 255, 255);
}

.crit-label {
    padding: 0;
    margin: 0;
    position: absolute;
    bottom: 75%;
    left: 50%;
    translate: -50% 0;
    opacity: 0;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}
