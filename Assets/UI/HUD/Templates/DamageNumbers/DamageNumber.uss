.damage-popup {
    position: absolute;
    translate: -50% -50%;
}

.number-group {
    align-items: center;
    overflow: visible;
}

.damage-label {
    padding: 0px;
    margin: 0px;
    color: rgb(255, 255, 255);
}

.crit-label {
    padding: 0px;
    margin: 0px;
    position: absolute;
    bottom: 75%;
    left: 50%;
    translate: -50% 0;
    opacity: 0;
    color: rgb(255, 255, 255);
}
