.hover-health-container {
    display: none;
    align-items: center;
    width: 100%;
    max-width: 20%;
}

.hover-name-label {
    color: white;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.hover-bar-wrapper {
    width: 100%;
}

.hover-bar-bg {
    width: 100%;
    height: 18px;
    background-color: rgb(30, 30, 30);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
}

.hover-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(220, 20, 20);
    border-radius: 4px;
}

.hover-hp-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    color: white;
    -unity-font-style: bold;
    font-size: 13px;
}
