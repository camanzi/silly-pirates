<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD/Templates/CrewMemberindicator/CrewMemberIndicatorStyle.uss?fileID=7433441132597879392&amp;guid=7dbb9ba4ea011fc4489d957dbf3be481&amp;type=3#CrewMemberIndicatorStyle"/>
    <Style src="project://database/Assets/UI/HUD/Shared/STL_Overlay.uss?fileID=7433441132597879392&amp;guid=fd57d09f3b11bac48a1efb8ec56b077e&amp;type=3#STL_Overlay"/>
    <ui:VisualElement name="main-wrapper" class="container" style="width: 100%; height: 100%;">
        <ui:VisualElement name="portrait" class="character-portrait" style="background-image: resource(&quot;Sprites/Characters/Human/SpriteSheets/idle_dir_N&quot;);"/>
        <ui:VisualElement name="info-column" class="info-column" style="width: 50%;">
            <ui:Label text="Character Name" name="name-label" class="name-label" style="font-size: 25%;"/>
            <ui:VisualElement name="health-bar-bg" class="health-bar" style="aspect-ratio: auto; height: 25px; width: 100%;">
                <ui:VisualElement name="health-bar-fill" class="health-bar-fill"/>
            </ui:VisualElement>
            <ui:VisualElement name="passives-container" class="passives-container"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
