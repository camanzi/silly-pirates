.container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: auto;
    margin-bottom: 30px;
    margin-left: 5px;
    overflow: visible;
}

.character-portrait {
    -unity-background-scale-mode: scale-to-fit;
    width: 25%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border-width: 0;
    flex-shrink: 0;
}

.info-column {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    margin-left: 10px;
    overflow: visible;
    position: relative;
}

.name-label {
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.health-bar {
    width: 100%;
    height: auto;
    background-color: rgb(30, 30, 30);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
    align-items: stretch;
    justify-content: flex-start;
    margin-bottom: 4px;
    aspect-ratio: 4.5;
}

.health-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(220, 20, 20);
    border-radius: 2px;
}

.passives-container {
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    flex-shrink: 0;
    overflow: visible;
    position: absolute;
    top: 100%;
    margin-top: 4px;
}
