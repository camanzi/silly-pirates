.container {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
}

.icon-anchor {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
}

.icon-image {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(20, 20, 20, 0.6);
    border-width: 2px;
    border-color: rgb(10, 10, 10);
    transform-origin: center;
}
