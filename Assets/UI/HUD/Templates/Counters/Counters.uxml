<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD/Templates/Counters/Counters.uss?fileID=7433441132597879392&amp;guid=58579c0279140a84cade1cf42648187f&amp;type=3#Counters"/>
    <Style src="project://database/Assets/UI/HUD/Shared/STL_WorldSpace.uss?fileID=7433441132597879392&amp;guid=982a6fb71843d3b45a6a8beb69b25ab0&amp;type=3#STL_WorldSpace"/>
    <ui:VisualElement name="container" picking-mode="Ignore" class="container">
        <ui:VisualElement name="current-counter-wrapper" picking-mode="Ignore" class="current-counter-wrapper">
            <ui:Label text="1" name="current-counter" picking-mode="Ignore" style="width: 100%; height: 100%;"/>
            <ui:Label name="awakening-preview" picking-mode="Ignore" text="+2" class="awakening-preview"/>
        </ui:VisualElement>
        <ui:Label text="/" name="divider" picking-mode="Ignore" style="-unity-text-align: middle-center;"/>
        <ui:Label text="99" name="max-counter" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>
