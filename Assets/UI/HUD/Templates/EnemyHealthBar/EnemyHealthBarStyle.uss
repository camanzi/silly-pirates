.container {
    translate: -50% 0%;
    width: 80px;
    height: auto;
}

.health-bar-bg {
    width: 100%;
    height: 10px;
    background-color: rgb(30, 30, 30);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
    align-items: stretch;
    justify-content: flex-start;
}

.health-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(220, 20, 20);
    border-radius: 2px;
}
