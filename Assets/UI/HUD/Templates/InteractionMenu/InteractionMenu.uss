.interaction-button {
    width: 150px;
    height: 150px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    margin: 0 25px;
}

.interaction-button__icon {
    width: 70%;
    height: 70%;
    -unity-background-scale-mode: scale-to-fit;
}

.interaction-button:disabled {
    opacity: 0.4;
}

.container {
    position: absolute;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 10px;
    padding: 5px;
    translate: -50% -50%;
}
