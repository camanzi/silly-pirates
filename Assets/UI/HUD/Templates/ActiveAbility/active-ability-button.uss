.active-ability-button {
    width: 150px;
    height: 150px;
    border-radius: 75px;
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    background-color: rgba(255, 255, 255, 0.3);
    overflow: hidden;
    padding: 20px;
    position: absolute;
    right: 100px;
    bottom: 175px;
    -unity-background-scale-mode: scale-to-fit;
}

.active-ability-button__icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}
