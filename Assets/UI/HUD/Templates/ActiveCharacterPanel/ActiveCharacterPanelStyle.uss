.acp-root {
    position: relative;
    width: 100%;
    height: 100%;
}

.acp-main-rect {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
    overflow: visible;
    padding: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.acp-portrait-wrapper {
    position: relative;
    height: 140%;
    aspect-ratio: 1;
    flex-shrink: 0;
    align-self: flex-end;
    margin-bottom: -12px;
    overflow: visible;
    justify-content: center;
    align-items: center;
}

.acp-portrait {
    width: 65%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
    border-width: 3px;
    border-color: rgb(10, 10, 10);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.acp-native-passive-slot {
    position: absolute;
    top: 0%;
    left: 0%;
}

.acp-info-column {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    flex-grow: 1;
    height: 100%;
    margin-left: 5%;
    overflow: visible;
    padding-top: 4%;
}

.acp-info-column .ap-container {
    width: 85%;
}

.acp-hp-bar-bg {
    position: relative;
    width: 85%;
    height: 22%;
    background-color: rgb(30, 30, 30);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
    overflow: visible;
    margin-bottom: 3%;
    justify-content: center;
    margin-right: 0%;
}

.acp-hp-bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(220, 20, 20);
    border-radius: 2px;
}

.acp-hp-label {
    position: absolute;
    bottom: 100%;
    right: -6%;
    margin-bottom: 2px;
    color: white;
    -unity-font-style: bold;
    font-size: 22.5px;
    -unity-text-align: lower-right;
    top: auto;
}

.acp-plank {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.acp-mp-container {
    position: absolute;
    right: 0;
    bottom: 100%;
    margin-bottom: 4px;
    width: 30%;
    height: 18%;
    flex-direction: row;
    flex-wrap: wrap-reverse;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(20, 20, 20, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(10, 10, 10);
    padding: 2px;
}
