.passive-popup-container {
    display: none; position: absolute; flex-direction: row; align-items: center;
    max-width: 260px; padding: 8px;
    background-color: rgba(20, 20, 20, 0.9);
    border-radius: 8px; border-width: 1px; border-color: rgb(10, 10, 10);
}
.passive-popup-icon {
    width: 32px; height: 32px; aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    -unity-background-scale-mode: scale-to-fit; margin-right: 8px; flex-shrink: 0;
}
.passive-popup-text { flex-direction: column; align-items: flex-start; white-space: normal; }
.passive-popup-name { color: white; -unity-font-style: bold; font-size: 14px; margin-bottom: 2px; }
.passive-popup-description { color: rgb(220, 220, 220); font-size: 12px; white-space: normal; }
