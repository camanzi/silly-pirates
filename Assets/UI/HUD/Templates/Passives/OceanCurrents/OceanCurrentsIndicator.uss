.wave-icon {
    height: 100%;
    aspect-ratio: 1;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Imports/2D/UI%20Icons/HUD/Passives/wave_icon.png?fileID=2800000&guid=f6eb7f139e9f7904baa9ac69898b1529&type=3#wave_icon");
}

.wave-active {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.wave-inactive {
    -unity-background-image-tint-color: rgb(74, 74, 74);
}
