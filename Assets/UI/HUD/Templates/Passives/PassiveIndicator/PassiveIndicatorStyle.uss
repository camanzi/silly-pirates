.passive-icon {
    width: 28px; 
    height: 28px; 
    aspect-ratio: 1;
    border-radius: 50%; 
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(20, 20, 20, 0.6);
    border-width: 2px; 
    border-color: rgb(10, 10, 10);
    margin-right: 4px; 
    flex-shrink: 0;
}

.passive-icon--large {
    width: 50px; 
    height: 50px;
    border-width: 3px;
}
