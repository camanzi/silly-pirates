.passive-icon {
    width: 28px;
    height: 28px;
    aspect-ratio: 1;
    position: relative;
    margin-right: 4px;
    flex-shrink: 0;
}

.passive-icon--large {
    width: 50px;
    height: 50px;
}

.icon-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(20, 20, 20, 0.6);
    border-width: 2px;
    border-color: rgb(10, 10, 10);
}

.icon-image--large {
    border-width: 3px;
}

.stack-badge {
    display: none;
    position: absolute;
    bottom: -25%;
    left: 50%;
    translate: -50% 0;
    min-width: 18px;
    height: 18px;
    padding: 0 2px;
    border-radius: 7px;
    background-color: rgba(20, 20, 20, 0.85);
    border-width: 1px;
    border-color: rgb(10, 10, 10);
    justify-content: center;
    align-items: center;
    aspect-ratio: 1;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
}

.stack-badge--large {
    min-width: 18px;
    height: 32px;
    border-radius: 9px;
    border-width: 2px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
}

.stack-badge-label {
    font-size: 10px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.stack-badge-label--large {
    font-size: 18px;
}
