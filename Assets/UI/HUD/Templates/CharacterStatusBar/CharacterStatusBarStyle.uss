.container {
    translate: -50% 0%;
    width: 80px;
    height: auto;
    overflow: visible;
}

.floating-icons-zone {
    position: absolute;
    bottom: 100%;
    left: 50%;
    translate: -50% 0%;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 2px;
}

.settled-passives {
    flex-direction: row;
    justify-content: flex-start;
    width: 100%;
    margin-top: 2px;
}

.settled-icon {
    -unity-background-scale-mode: scale-to-fit;
}

.health-bar-bg {
    width: 100%;
    height: 10px;
    background-color: rgb(30, 30, 30);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
    align-items: stretch;
    justify-content: flex-start;
}

.health-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(220, 20, 20);
    border-radius: 2px;
}
