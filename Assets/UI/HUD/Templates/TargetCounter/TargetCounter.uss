.target-counter-container {
    position: absolute;
    display: none;
    translate: 0 -50%;
}

.target-counter-label {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 255);
}

.target-counter-label--complete {
    color: rgb(120, 230, 130);
}
