.boss-health-container {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}

.boss-name-label {
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.boss-bar-wrapper {
    width: 50%;
    overflow: visible;
}

.boss-bar-bg {
    width: 100%;
    height: 24px;
    background-color: rgb(30, 30, 30);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
}

.boss-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(220, 20, 20);
    border-radius: 4px;
}

.boss-percent-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    color: white;
    -unity-font-style: bold;
    font-size: 14px;
}

.boss-icon {
    position: absolute;
    left: -60px;
    top: -13px;
    width: 50px;
    height: 50px;
    border-radius: 25px;
    border-width: 2px;
    border-color: rgb(10, 10, 10);
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}
